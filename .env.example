MYSQL_PASSWORD=nexo_secret
MYSQL_ROOT_PASSWORD=root_secret

ADMIN_USERNAME=admin
ADMIN_PASSWORD=lmujica
ADMIN_SESSION_SECRET=cambia-este-secreto-en-produccion

# Documentación API (/doc/api) — Vercel: definir en Project → Settings → Environment Variables.
# Si DOC_API_PASSWORD está vacío, la doc queda abierta (solo pruebas locales).
# Recomendado — usuario y contraseña juntos (varios separados por coma):
# DOC_API_USERS=integrador1:claveSecreta1,integrador2:claveSecreta2
#
# Alternativa — listas paralelas:
# DOC_API_USERNAME=integrador1,integrador2
# DOC_API_PASSWORD=clave1,clave2
DOC_API_USERS=
DOC_API_USERNAME=doc
DOC_API_PASSWORD=
DOC_SESSION_SECRET=
DOC_API_DEV_PORT=3099
