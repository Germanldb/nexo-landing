---
import BaseLayout from '../../layouts/BaseLayout.astro';

const nextParam = Astro.url.searchParams.get('next') ?? '/doc/api';
const safeNext =
  nextParam.startsWith('/doc/') && !nextParam.startsWith('//') ? nextParam : '/doc/api';
---

<BaseLayout
  title="Acceso documentación API | Nexo"
  description="Acceso restringido a la referencia técnica de la API Nexo."
>
  <main class="min-h-screen flex items-center justify-center px-6 py-24">
    <div class="w-full max-w-md nexo-form-card p-8 md:p-10">
      <div class="text-center mb-8">
        <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-nexo-primary/10 text-nexo-primary text-[10px] font-bold tracking-[0.2em] uppercase border border-nexo-primary/20 mb-5">
          Documentación API
        </span>
        <h1 class="text-3xl font-extrabold text-nexo-dark tracking-tight">Acceso restringido</h1>
        <p class="text-nexo-text-muted mt-3 text-sm leading-relaxed">
          Referencia técnica para integradores y clientes Nexo. Las credenciales las entrega el equipo Nexo para enlaces temporales (por ejemplo en Vercel).
        </p>
      </div>

      <form id="doc-login-form" class="nexo-form space-y-6" novalidate data-next={safeNext}>
        <div>
          <label for="doc-username" class="nexo-form-label">Usuario</label>
          <input
            id="doc-username"
            name="username"
            type="text"
            autocomplete="username"
            required
            class="nexo-form-input mt-1"
          />
        </div>
        <div>
          <label for="doc-password" class="nexo-form-label">Contraseña</label>
          <input
            id="doc-password"
            name="password"
            type="password"
            autocomplete="current-password"
            required
            class="nexo-form-input mt-1"
          />
        </div>

        <p id="doc-login-error" class="hidden nexo-form-error" role="alert"></p>
        <p id="doc-login-open" class="hidden text-xs text-nexo-dark/50 leading-relaxed">
          En este entorno la documentación API está abierta; puede continuar sin iniciar sesión.
        </p>

        <a
          id="doc-login-skip"
          href={safeNext}
          class="hidden nexo-form-submit w-full text-center no-underline"
        >
          Continuar a la documentación
        </a>
        <button type="submit" class="nexo-form-submit w-full">Entrar</button>
        <a href="/doc/docpage" class="block text-center text-xs text-nexo-dark/45 hover:text-nexo-primary transition-colors">
          Volver al manual de usuario
        </a>
      </form>
    </div>
  </main>
</BaseLayout>

<script>
  const form = document.getElementById('doc-login-form') as HTMLFormElement | null;
  const errorEl = document.getElementById('doc-login-error');
  const openEl = document.getElementById('doc-login-open');
  const skipEl = document.getElementById('doc-login-skip');
  const nextPath = form?.dataset.next ?? '/doc/api';

  async function redirectIfAuthenticated() {
    try {
      const response = await fetch('/api/doc/session', { credentials: 'include' });
      const data = (await response.json()) as { ok?: boolean; mode?: string };
      if (response.ok && data.ok) {
        window.location.href = nextPath;
        return;
      }
      if (response.ok === false && data.mode === undefined) {
        /* sin acceso */
      }
    } catch {
      /* API no disponible en build estático puro */
    }
  }

  async function detectOpenAccess() {
    try {
      const response = await fetch('/api/doc/session', { credentials: 'include' });
      const data = (await response.json()) as { ok?: boolean; mode?: string; protected?: boolean };
      if (data.ok && data.mode === 'open') {
        openEl?.classList.remove('hidden');
        skipEl?.classList.remove('hidden');
      }
    } catch {
      /* ignore */
    }
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    errorEl?.classList.add('hidden');

    const username = (form.elements.namedItem('username') as HTMLInputElement)?.value.trim() ?? '';
    const password = (form.elements.namedItem('password') as HTMLInputElement)?.value ?? '';
    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    submitBtn?.setAttribute('disabled', 'true');

    try {
      const response = await fetch('/api/doc/login', {
        method: 'POST',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ username, password }),
      });

      const data = (await response.json()) as { ok?: boolean; message?: string };

      if (!response.ok || !data.ok) {
        if (errorEl) {
          errorEl.textContent = data.message ?? 'Usuario o contraseña incorrectos.';
          errorEl.classList.remove('hidden');
        }
        return;
      }

      window.location.href = nextPath;
    } catch {
      if (errorEl) {
        errorEl.textContent =
          'Error de conexión. En local use pnpm run dev (inicia la API de doc en el puerto 3099). En Vercel, configure las variables DOC_API_* y redeploy.';
        errorEl.classList.remove('hidden');
      }
    } finally {
      submitBtn?.removeAttribute('disabled');
    }
  });

  redirectIfAuthenticated();
  detectOpenAccess();
</script>
