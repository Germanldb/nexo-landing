---
import BaseLayout from '../../layouts/BaseLayout.astro';

export interface DocNavItem {
  title: string;
  id: string;
  href?: string;
}

export interface DocNavGroup {
  label: string;
  items: DocNavItem[];
}

interface Props {
  title: string;
  description: string;
  kicker?: string;
  sidebarTitle?: string;
  sidebarSubtitle?: string;
  navGroups: DocNavGroup[];
  alternateDoc?: {
    href: string;
    label: string;
    description: string;
  };
}

const {
  title,
  description,
  kicker = 'Documentación',
  sidebarTitle = 'Nexo',
  sidebarSubtitle = 'Manual de usuario',
  navGroups,
  alternateDoc,
} = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="doc-page flex min-h-screen">
    <aside id="doc-sidebar" class="doc-sidebar w-72 xl:w-80 shrink-0 fixed top-0 left-0 h-screen overflow-y-auto px-4 pt-4 pb-4 z-40 hidden lg:block transition-transform duration-300">
      <div class="mb-2 px-1">
        <span class="text-[10px] font-bold tracking-[0.2em] uppercase text-nexo-primary">{kicker}</span>
        <h2 class="text-xl font-extrabold text-nexo-dark mt-0.5">{sidebarTitle}</h2>
        <p class="text-[11px] text-nexo-dark/40 mt-0.5 leading-snug">{sidebarSubtitle}</p>
      </div>

      {alternateDoc && (
        <a
          href={alternateDoc.href}
          class="doc-alt-link mb-4 block rounded-2xl border border-nexo-dark/10 bg-nexo-dark/[0.03] px-4 py-3 hover:border-nexo-primary/35 hover:bg-nexo-primary/5 transition-colors"
        >
          <span class="text-[10px] font-bold uppercase tracking-widest text-nexo-primary">{alternateDoc.label}</span>
          <p class="text-xs text-nexo-dark/55 mt-1 leading-snug">{alternateDoc.description}</p>
        </a>
      )}

      <nav class="doc-nav" aria-label="Contenido del manual">
        {navGroups.map((group, groupIndex) => (
          <div class="doc-nav-group is-collapsed" data-nav-group={groupIndex}>
            <button
              type="button"
              class="doc-nav-group-toggle"
              aria-expanded="false"
              aria-controls={`doc-nav-group-${groupIndex}`}
            >
              <span>{group.label}</span>
              <svg class="doc-nav-group-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>
            <div id={`doc-nav-group-${groupIndex}`} class="doc-nav-group-items" role="region">
              {group.items.map(item => (
                <a
                  href={item.href ?? `#${item.id}`}
                  class="doc-nav-link"
                  data-section-id={item.id}
                >
                  {item.title}
                </a>
              ))}
            </div>
          </div>
        ))}
      </nav>
    </aside>

    <button
      id="doc-sidebar-toggle"
      class="lg:hidden fixed bottom-6 right-6 z-50 w-14 h-14 rounded-full bg-nexo-dark text-white shadow-xl flex items-center justify-center hover:bg-nexo-primary hover:text-nexo-dark transition-all"
      aria-label="Abrir navegación"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
    </button>

    <div id="doc-sidebar-overlay" class="lg:hidden fixed inset-0 bg-black/40 z-40 hidden opacity-0 transition-opacity duration-300"></div>

    <main class="flex-1 lg:ml-72 xl:ml-80 min-w-0">
      <div class="px-6 sm:px-10 lg:px-16 xl:px-20 pt-4 pb-12 lg:pt-4 lg:pb-16">
        <slot />

        <div class="mt-8 pt-6 border-t border-nexo-dark/10 text-center">
          <a href="#intro" class="doc-back-top inline-flex items-center gap-2 text-xs font-semibold text-nexo-dark/35 hover:text-nexo-primary transition-colors">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"></path></svg>
            Volver al inicio
          </a>
        </div>
      </div>
    </main>
  </div>

  <script>
    const links = document.querySelectorAll('.doc-nav-link');
    const sections = document.querySelectorAll('section[id]');
    const sidebar = document.getElementById('doc-sidebar');
    const toggle = document.getElementById('doc-sidebar-toggle');
    const overlay = document.getElementById('doc-sidebar-overlay');
    const navGroups = document.querySelectorAll('.doc-nav-group');
    const backTop = document.querySelector('.doc-back-top');

    const firstSection = sections[0]?.id;
    if (backTop instanceof HTMLAnchorElement && firstSection) {
      backTop.href = `#${firstSection}`;
    }

    function setGroupExpanded(group, expanded) {
      const btn = group.querySelector('.doc-nav-group-toggle');
      if (!btn) return;
      btn.setAttribute('aria-expanded', expanded ? 'true' : 'false');
      group.classList.toggle('is-collapsed', !expanded);
    }

    function openOnlyGroup(targetGroup) {
      navGroups.forEach(group => {
        setGroupExpanded(group, group === targetGroup);
      });
    }

    function setActiveLink(sectionId) {
      links.forEach(l => l.classList.remove('active'));
      navGroups.forEach(g => g.classList.remove('is-active-group'));

      const active = document.querySelector(`.doc-nav-link[data-section-id="${sectionId}"]`);
      const group = active?.closest('.doc-nav-group');
      active?.classList.add('active');
      if (group) {
        group.classList.add('is-active-group');
        openOnlyGroup(group);
      }
      active?.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    }

    navGroups.forEach(group => {
      const btn = group.querySelector('.doc-nav-group-toggle');
      btn?.addEventListener('click', () => {
        const isOpen = btn.getAttribute('aria-expanded') === 'true';
        if (isOpen) {
          setGroupExpanded(group, false);
        } else {
          openOnlyGroup(group);
        }
      });
    });

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          setActiveLink(entry.target.id);
        }
      });
    }, { rootMargin: '-80px 0px -70% 0px' });

    sections.forEach(s => observer.observe(s));

    links.forEach(link => {
      link.addEventListener('click', () => {
        if (window.innerWidth < 1024) {
          sidebar?.classList.add('hidden');
          overlay?.classList.add('hidden');
          overlay?.classList.remove('opacity-100');
          overlay?.classList.add('opacity-0');
          setTimeout(() => overlay?.classList.add('hidden'), 300);
        }
      });
    });

    toggle?.addEventListener('click', () => {
      const isHidden = sidebar?.classList.contains('hidden');
      sidebar?.classList.toggle('hidden');
      overlay?.classList.toggle('hidden');
      if (isHidden) {
        requestAnimationFrame(() => {
          overlay?.classList.remove('opacity-0');
          overlay?.classList.add('opacity-100');
        });
      } else {
        overlay?.classList.remove('opacity-100');
        overlay?.classList.add('opacity-0');
      }
    });

    overlay?.addEventListener('click', () => {
      sidebar?.classList.add('hidden');
      overlay?.classList.remove('opacity-100');
      overlay?.classList.add('opacity-0');
      setTimeout(() => overlay?.classList.add('hidden'), 300);
    });

    if (window.location.hash) {
      const id = window.location.hash.slice(1);
      if (document.getElementById(id)) setActiveLink(id);
    }
  </script>
</BaseLayout>
