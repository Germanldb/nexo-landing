---
import DocImage from './DocImage.astro';
import imgBarra from '../../assets/img-docs/doc-55.png';
import imgMenuUsuario from '../../assets/img-docs/doc-56.png';

interface Props { id?: string; }
const { id } = Astro.props;

const features = [
  {
    title: 'Buscar cliente',
    desc: 'Escriba al menos 3 caracteres (nombre, cédula o código) y abra la ficha desde la lista.',
  },
  {
    title: 'Pago rápido',
    desc: 'El icono $ abre Registrar Pagos directo. Requiere acceso de pago activo.',
  },
  {
    title: 'Capturar pantalla',
    desc: 'Genera una captura del panel actual (útil para reportar incidencias). Sin permiso especial.',
  },
  {
    title: 'Tema',
    desc: 'Alterna claro/oscuro (luna/sol). Si no eligió aún, respeta el sistema; luego puede guardar su estilo.',
  },
];

const extraAccess = [
  { name: 'Telegram', desc: 'Mensajes y contador de conversaciones no leídas.' },
  { name: 'Soporte', desc: 'Icono de disco: tickets asignados al operador.' },
  { name: 'Notificaciones', desc: 'Panel de alertas (campanita) del sistema.' },
];

const userMenu = [
  { option: 'Asistencia', desc: 'Entrada, salida y registros del operador' },
  { option: 'Mi Perfil', desc: 'Datos del operador' },
  { option: 'Cambiar Contraseña', desc: 'Actualizar acceso' },
  { option: 'Cerrar Sesión', desc: 'Salir del sistema' },
];
---

<section id={id} class="doc-section mb-16">
  <div class="mb-6">
    <span class="text-[10px] font-bold tracking-[0.2em] uppercase text-nexo-primary mb-2 block">Sección 4</span>
    <h2 class="text-3xl md:text-4xl font-extrabold text-nexo-dark tracking-tight">Barra superior</h2>
    <p class="text-nexo-dark/50 text-sm mt-2">Accesos rápidos siempre visibles.</p>
  </div>

  <div class="space-y-6">
    <DocImage
      src={imgBarra}
      alt="Barra superior de Nexo con buscador e iconos de acceso rápido"
      caption="Barra superior: buscar cliente e iconos de acciones."
    />

    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-3">
      {features.map(f => (
        <div class="doc-card !p-4">
          <h3 class="font-bold text-nexo-dark text-sm mb-1.5">{f.title}</h3>
          <p class="text-nexo-dark/55 text-xs leading-relaxed">{f.desc}</p>
        </div>
      ))}
    </div>

    <div>
      <h3 class="text-lg font-bold text-nexo-dark mb-2">Notificaciones: campanita y toast de almacén</h3>
      <p class="text-nexo-dark/60 text-sm mb-3">Hay dos canales distintos; no los confunda.</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-3">
        <div class="doc-card !py-4 !px-5">
          <h4 class="font-bold text-nexo-dark text-sm mb-2">Campanita</h4>
          <p class="text-nexo-dark/60 text-xs leading-relaxed mb-2">
            Lista de alertas: pagos, tickets, red y entregas de almacén. Marque como leídas al revisarlas.
          </p>
          <p class="text-nexo-dark/55 text-xs leading-relaxed">
            Las de <strong class="text-nexo-dark">entrega a almacén</strong> no se pueden descartar hasta aceptar o rechazar. “Eliminar todo” las omite.
          </p>
        </div>
        <div class="doc-card !py-4 !px-5 border-amber-200/80">
          <h4 class="font-bold text-nexo-dark text-sm mb-2">Toast naranja de almacén</h4>
          <p class="text-nexo-dark/60 text-xs leading-relaxed mb-2">
            Tarjeta arriba a la derecha con botón <strong class="text-nexo-dark">Revisar</strong>. No se cierra sola.
          </p>
          <ul class="space-y-1.5 text-xs text-nexo-dark/60">
            <li><strong class="text-nexo-dark">Entrega pendiente:</strong> jefe de almacén → abre entregas.</li>
            <li><strong class="text-nexo-dark">Unidad por confirmar:</strong> técnico → confirma inventario asignado.</li>
          </ul>
          <p class="text-nexo-dark/45 text-[11px] mt-2">Si el técnico se autoasignó la unidad, no recibe toast.</p>
        </div>
      </div>
    </div>

    <div>
      <h3 class="text-lg font-bold text-nexo-dark mb-2">Otros accesos (según permisos)</h3>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 mb-4">
        {extraAccess.map(a => (
          <div class="bg-nexo-dark/[0.02] border border-nexo-dark/5 rounded-lg px-3 py-2.5">
            <p class="font-bold text-nexo-dark text-xs">{a.name}</p>
            <p class="text-nexo-dark/50 text-[11px] mt-0.5 leading-snug">{a.desc}</p>
          </div>
        ))}
      </div>
    </div>

    <div>
      <h3 class="text-lg font-bold text-nexo-dark mb-4">Menú de usuario</h3>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 items-start">
        <DocImage
          src={imgMenuUsuario}
          alt="Menú desplegable del avatar de usuario en Nexo"
          caption="Avatar: Asistencia, Perfil, Contraseña y Cerrar sesión."
        />
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-1 gap-3">
          {userMenu.map(item => (
            <div class="flex items-center gap-3 bg-nexo-dark/[0.02] border border-nexo-dark/5 rounded-xl px-4 py-3">
              <span class="w-1.5 h-1.5 rounded-full bg-nexo-primary shrink-0"></span>
              <div class="min-w-0">
                <p class="font-bold text-nexo-dark text-sm">{item.option}</p>
                <p class="text-nexo-dark/50 text-xs">{item.desc}</p>
              </div>
            </div>
          ))}
          <div class="doc-card !py-3 !px-4">
            <p class="font-bold text-nexo-dark text-xs mb-1">Consultar asistencia</p>
            <p class="text-nexo-dark/55 text-[11px] leading-relaxed">
              Menú → <strong class="text-nexo-dark">Asistencia</strong> → revise entradas/salidas. Si falta un registro, avise al administrador.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
