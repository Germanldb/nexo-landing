---
interface Props { id?: string; }
const { id } = Astro.props;

const flows = [
  {
    title: 'Alta sin instalación',
    steps: [
      'Clientes → Usuarios → Nuevo',
      'Datos → Facturación → Servicios',
      'Registrar → factura y servicio activos',
    ],
  },
  {
    title: 'Alta con instalación',
    steps: [
      'Instalaciones → registro → técnico y materiales',
      'Tarea: En curso → Finalizar',
      'Dar de alta (wizard precargado)',
    ],
  },
  {
    title: 'Cobro en caja',
    steps: [
      'Barra → $ → cliente y factura',
      'Forma de pago + monto → registrar',
      'Reactiva si estaba suspendido',
    ],
  },
  {
    title: 'Morosidad',
    steps: [
      'Sistema: factura → avisos → corte',
      'Cliente paga (caja o portal)',
      'Servicio reactivado',
    ],
  },
  {
    title: 'Ficha hotspot',
    steps: [
      'Nuevo lote → imprimir',
      'Entregar / marcar vendida',
      'Consultar en Ventas',
    ],
  },
  {
    title: 'Soporte',
    steps: [
      'Ticket (portal u operador)',
      'Respuesta en Esperando',
      'Cerrar al resolver',
    ],
  },
  {
    title: 'Facturación fiscal Serdimpre',
    steps: [
      'Se genera la factura → documento pendiente en Serdimpre (USD)',
      'Ficha → columna Facturación (estado en vivo)',
      'Si falla: reenvío desde el badge; al borrar, sync y bloqueo si ya facturó',
    ],
  },
  {
    title: 'Entrega y asignación de unidad',
    steps: [
      'Devolución: técnico solicita → toast al jefe → acepta (evidencia opcional)',
      'Asignación: jefe asigna unidad → toast al técnico → acepta inventario',
      'Inventario vuelve a bodega o queda a cargo del técnico',
    ],
  },
];
---

<section id={id} class="doc-section mb-16">
  <div class="mb-6">
    <span class="text-[10px] font-bold tracking-[0.2em] uppercase text-nexo-primary mb-2 block">Sección 20</span>
    <h2 class="text-3xl md:text-4xl font-extrabold text-nexo-dark tracking-tight">Flujos de trabajo</h2>
    <p class="text-nexo-dark/50 text-sm mt-2">Procesos clave de punta a punta, incluyendo lo automático del sistema.</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    {flows.map(flow => (
      <div class="doc-card !py-4 !px-5">
        <h3 class="text-sm font-bold text-nexo-dark mb-3">{flow.title}</h3>
        <div class="space-y-0">
          {flow.steps.map((step, i) => (
            <div class="flex items-start gap-2.5">
              <div class="flex flex-col items-center">
                <span class="w-5 h-5 rounded-full bg-nexo-primary text-nexo-dark flex items-center justify-center text-[10px] font-bold shrink-0">{i + 1}</span>
                {i < flow.steps.length - 1 && <div class="w-0.5 h-3 bg-nexo-dark/10 my-0.5"></div>}
              </div>
              <span class="text-xs text-nexo-dark/65 leading-relaxed pt-0.5">{step}</span>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
