---
interface Props { id?: string; }
const { id } = Astro.props;

const errors = [
  { code: '400', action: 'Parámetros faltantes o formato inválido' },
  { code: '401', action: 'No autenticado; token o JWT ausente o vencido' },
  { code: '403', action: 'API deshabilitada, token incorrecto, o DELETE bloqueado por Apache' },
  { code: '404', action: 'Módulo, cliente, factura o recurso inexistente' },
  { code: '405', action: 'Método HTTP no permitido en esa ruta' },
  { code: '409', action: 'Conflicto: referencia duplicada, OTP inválido o pago no concilia' },
  { code: '422', action: 'JSON válido pero rechazado por regla de negocio' },
  { code: '500', action: 'Error interno del servidor' },
  { code: '502', action: 'Proxy v1/v2, banco o servicio externo no respondió' },
  { code: '503', action: 'Pasarela o módulo no configurado / no migrado' },
];

const checklist = [
  'Cree un operador con API = 1 y genere token_api en el panel.',
  'Pruebe POST /api/auth y guarde el JWT (3600 s).',
  'Use v21 (módulos Nexo) o v11 (comandos v1) con Authorization: Bearer.',
  'Para cobros VE: confirme pasarela BDV/C2P y tasa del día en dolarprice.',
  'Pago móvil offline: el banco debe notificar a /api/webhooks/bdv.php antes de conciliar.',
  'No use DELETE HTTP; no exponga el token en URLs ni logs.',
];

const frequent = [
  { symptom: '403 Token Bearer no autorizado', fix: 'Regenerar token_api y habilitar API en el operador' },
  { symptom: '403 … no tiene token_api', fix: 'El JWT es de un usuario sin token API para el proxy' },
  { symptom: '409 referencia no encontrada', fix: 'Verifique pagos_bdv y últimos 6 dígitos de la referencia' },
  { symptom: '503 pasarela inactiva', fix: 'Ajustes → Pasarelas y credenciales (X-API-Key BDV, etc.)' },
  { symptom: '502 proxy no respondió', fix: 'Revisar PHP/Apache en el servidor Nexo' },
];

const banned = [
  { path: 'Webhooks de bancos', why: 'Los llama el proveedor, no su integración saliente' },
  { path: 'Panel admin / AJAX interno', why: 'Sesión de operador en navegador, no API pública' },
];

const practices = [
  'Un operador API por integración, solo con las sucursales necesarias.',
  'Token en variables de entorno; nunca en Git, logs ni en el frontend del abonado.',
  'Configure timeouts y registre el código HTTP, no las credenciales.',
  'En pagos use referencias únicas y valide el resultado antes de reintentar.',
  'Si sospecha filtración, rote el token o desactive la API de ese operador.',
];
---

<section id={id} class="doc-section mb-16">
  <div class="mb-6">
    <span class="text-[10px] font-bold tracking-[0.2em] uppercase text-nexo-primary mb-2 block">Integraciones</span>
    <h2 class="text-2xl md:text-3xl font-extrabold text-nexo-dark tracking-tight">Errores y seguridad</h2>
    <p class="text-nexo-dark/60 text-sm mt-3 max-w-2xl leading-relaxed">
      Cómo interpretar respuestas fallidas, qué no llamar desde un sistema de terceros
      y prácticas mínimas para no exponer el token.
    </p>
  </div>

  <div class="space-y-8">
    <div>
      <h3 class="text-lg font-bold text-nexo-dark mb-3">Códigos que verá con frecuencia</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
        {errors.map(e => (
          <div class="flex items-start gap-3 bg-nexo-dark/[0.02] border border-nexo-dark/5 rounded-lg px-3 py-2.5">
            <span class="font-bold text-nexo-dark text-xs shrink-0 w-8">{e.code}</span>
            <p class="text-nexo-dark/55 text-[11px] leading-snug">{e.action}</p>
          </div>
        ))}
      </div>
      <p class="text-nexo-dark/45 text-xs mt-3 mb-2 leading-relaxed">Ejemplo de error en JSON:</p>
      <pre class="doc-code-block" tabindex="0"><code>{`{ "ok": false, "salida": "Token inválido." }
{ "estado": "error", "salida": "No se encontró el cliente." }`}</code></pre>
    </div>

    <div>
      <h3 class="text-lg font-bold text-nexo-dark mb-2">Checklist de integración</h3>
      <ol class="space-y-2 text-sm text-nexo-dark/65 list-decimal pl-5 mb-8">
        {checklist.map((step) => (
          <li>{step}</li>
        ))}
      </ol>
    </div>

    <div>
      <h3 class="text-lg font-bold text-nexo-dark mb-3">Errores frecuentes</h3>
      <div class="space-y-2 mb-8">
        {frequent.map((f) => (
          <div class="doc-card !py-3 !px-4">
            <p class="font-bold text-nexo-dark text-xs">{f.symptom}</p>
            <p class="text-nexo-dark/55 text-[11px] mt-0.5">{f.fix}</p>
          </div>
        ))}
      </div>
    </div>

    <div>
      <h3 class="text-lg font-bold text-nexo-dark mb-2">No use esto como API de terceros</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
        {banned.map(b => (
          <div class="doc-card !py-3 !px-4">
            <p class="font-bold text-nexo-dark text-xs mb-0.5">{b.path}</p>
            <p class="text-nexo-dark/50 text-[11px]">{b.why}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="doc-card !py-4 !px-5">
      <h3 class="font-bold text-nexo-dark text-sm mb-2">Buenas prácticas</h3>
      <ul class="space-y-2">
        {practices.map(p => (
          <li class="flex items-start gap-2 text-xs text-nexo-dark/65 leading-relaxed">
            <span class="w-1.5 h-1.5 rounded-full bg-nexo-primary mt-1.5 shrink-0"></span>
            {p}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
