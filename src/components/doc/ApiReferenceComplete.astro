---
import referenceData from '../../data/nexo-api-reference.json';
import ApiReferenceChapter from './ApiReferenceChapter.astro';
import type { ReferenceChapter } from './ApiReferenceChapter.astro';
import { buildPublicReferenceChapters } from '../../lib/api-doc-public-chapters';

interface Props {
  id?: string;
}

const { id = 'api-referencia-completa' } = Astro.props;

const chapters = buildPublicReferenceChapters(referenceData.chapters as ReferenceChapter[]);
---

<section id={id} class="doc-section mb-16 doc-reference-root">
  <div class="doc-reference-layout space-y-14">
    {chapters.map((chapter) => (
      <ApiReferenceChapter chapter={chapter} />
    ))}
  </div>
</section>
